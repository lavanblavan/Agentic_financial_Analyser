# Local only. Copy to .env and fill in values:
#   copy .env.example .env
#
# Never commit .env.
# In Google Colab, skip this file. Add the same names under
# the key icon (Secrets), then grant the notebook access.

GROQ_API_KEY=
# JSON sentiment / structured calls (Task 1 default).
GROQ_MODEL=openai/gpt-oss-20b
# ReAct tool loop. Cap max_tokens under Groq free OTPM (1000).
GROQ_AGENT_MODEL=openai/gpt-oss-20b
LLM_MAX_TOKENS=800

# Optional OpenRouter fallback (https://openrouter.ai/keys). Used on Groq 429.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b:free

TICKER=NVDA
LOOKBACK=1y
