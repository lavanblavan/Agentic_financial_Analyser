# Local only. Copy to .env and fill in values:
#   copy .env.example .env
#
# Never commit .env.
# In Google Colab, skip this file. Add the same names under
# the key icon (Secrets), then grant the notebook access.

GROQ_API_KEY=
# JSON sentiment / structured calls (Task 1 default).
GROQ_MODEL=openai/gpt-oss-20b
# ReAct tool loop. Do not use gpt-oss here — it stops after 1–2 tools.
GROQ_AGENT_MODEL=llama-3.3-70b-versatile

TICKER=NVDA
LOOKBACK=1y
