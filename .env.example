# Local only. Copy to .env and fill in values:
#   copy .env.example .env
#
# Never commit .env.
# In Google Colab, skip this file. Add the same names under
# the key icon (Secrets), then grant the notebook access.

# Preferred: OpenRouter (https://openrouter.ai/keys). Used first when set.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b:free
LLM_MAX_TOKENS=2048

# Optional Groq fallback (https://console.groq.com/keys).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_AGENT_MODEL=openai/gpt-oss-20b

TICKER=NVDA
LOOKBACK=1y
